{
  "name": "calisma-masasi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Çalışma Masası: tarayıcıda çalışan PDF okuma, vurgulama ve not alma aracı.",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs && node scripts/copy-ocr.mjs",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@fontsource/ibm-plex-mono": "5.1.0",
    "@fontsource/ibm-plex-sans": "5.1.0",
    "@fontsource/source-serif-4": "5.1.0",
    "@mlc-ai/web-llm": "0.2.85",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/tur": "1.0.0",
    "docx": "9.11.0",
    "jszip": "3.10.1",
    "katex": "0.18.11",
    "openai": "7.35.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "pptxgenjs": "4.0.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "fake-indexeddb": "6.0.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
