{
  "name": "calisma-masasi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Çalışma Masası: tarayıcıda çalışan PDF okuma, vurgulama ve not alma aracı.",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.1.0",
    "@fontsource/ibm-plex-sans": "5.1.0",
    "@fontsource/source-serif-4": "5.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "fake-indexeddb": "6.0.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
